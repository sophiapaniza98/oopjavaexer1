package com.mycompany.m2exer6;


import java.util.Scanner;

public class M2exer6 {

    static class Movie {
        String title;
        String director;
        int releaseYear;
        int runtime;
        double rating;

        Movie(String title, String director, int releaseYear, int runtime, double rating) {
            this.title = title;
            this.director = director;
            this.releaseYear = releaseYear;
            this.runtime = runtime;
            this.rating = rating;
        }

        void displayMovieInfo() {
            System.out.println();
            System.out.println("Movie Information");
            System.out.println("-----------------");
            System.out.println("Title: " + title);
            System.out.println("Director: " + director);
            System.out.println("Release Year: " + releaseYear);
            System.out.println("Runtime: " + runtime + " minutes");
            System.out.println("Rating: " + rating);
        }
    }

    public static void main(String[] args) {
        try (Scanner input = new Scanner(System.in)) {
            System.out.print("Enter movie title: ");
            String title = input.nextLine();
            
            System.out.print("Enter director: ");
            String director = input.nextLine();
            
            System.out.print("Enter release year: ");
            int releaseYear = input.nextInt();
            
            System.out.print("Enter runtime in minutes: ");
            int runtime = input.nextInt();
            
            System.out.print("Enter rating: ");
            double rating = input.nextDouble();
            
            Movie movie = new Movie(title, director, releaseYear, runtime, rating);
            
            movie.displayMovieInfo();
        }
    }
}
