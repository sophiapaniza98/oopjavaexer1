package com.mycompany.m2exer9;

import java.util.Scanner;

public class M2exer9 {

    public static void main(String[] args) {

        try (Scanner input = new Scanner(System.in)) {
            System.out.print("Enter username: ");
            String username = input.nextLine();
            
            System.out.print("Enter character name: ");
            String characterName = input.nextLine();
            
            System.out.print("Enter level: ");
            int level = input.nextInt();
            
            System.out.print("Enter experience points: ");
            long experiencePoints = input.nextLong();
            
            input.nextLine(); // clears the leftover newline
            
            System.out.print("Enter rank: ");
            String rank = input.nextLine();
            
            System.out.println("\n--- Player Profile ---");
            System.out.println("Username: " + username);
            System.out.println("Character Name: " + characterName);
            System.out.println("Level: " + level);
            System.out.println("Experience Points: " + experiencePoints);
            System.out.println("Rank: " + rank);
        }
    }
}
